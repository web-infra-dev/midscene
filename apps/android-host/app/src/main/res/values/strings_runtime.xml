    <string name="adb_error_authorize">connected to %1$s but this app is not authorized. Approve the &quot;Allow USB debugging?&quot; prompt on the device, then tap Reconnect.</string>
    <string name="adb_error_shell_uid">connected to %1$s, but the shell did not answer as uid 2000: %2$s</string>
    <string name="adb_error_connect_failed">adb connect failed: %1$s</string>
    <string name="adb_error_pairing_rejected">the device rejected the pairing: %1$s</string>
    <string name="adb_error_pairing_code">pairing code must be six digits</string>
    <string name="adb_error_pairing_address">pairing address is empty</string>
    <string name="adb_error_connection_address">connection address is empty</string>
