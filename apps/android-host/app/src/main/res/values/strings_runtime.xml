    <string name="channel_shizuku_no_binder">Shizuku is not running. Start Shizuku, then provision again.</string>
    <string name="channel_shizuku_not_authorized">This app is not authorized in Shizuku. Tap Authorize in Diagnostics, then provision again.</string>
    <string name="channel_shizuku_no_service">Shizuku is authorized but the user service did not start. Retry the binding, or restart Shizuku.</string>
