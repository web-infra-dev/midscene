    <string name="channel_shizuku_bound">Shizuku user service bound as uid %1$d</string>
    <string name="channel_pairing_incomplete">Pairing was never completed. Pair this device.</string>
    <string name="channel_not_paired">Not paired yet. Pair once; the connection renews itself after that.</string>
    <string name="channel_no_connection">Paired but not connected. Turn wireless debugging on and tap Reconnect.</string>
    <string name="channel_unreachable">adb is not reachable at %1$s. Keep wireless debugging on, then retry.</string>
