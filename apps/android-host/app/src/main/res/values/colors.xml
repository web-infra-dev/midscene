<?xml version="1.0" encoding="utf-8"?>
<!--
  Studio palette for the *window* theme only (`values/themes.xml`): the system bars and
  the pre-Compose window background. The Compose design tokens — the full set, including
  the status colours — live in `ui/theme/StudioTheme.kt`, which is what the UI reads.
  Dark values live in values-night/colors.xml.
-->
<resources>
    <color name="app_bg">#F6F6F6</color>
    <color name="surface">#FFFFFF</color>

    <color name="border_subtle">#ECECEC</color>
    <color name="border_strong">#E9ECF3</color>

    <color name="text_primary">#0D0D0D</color>
    <color name="text_secondary">#474848</color>

    <color name="brand">#1979FF</color>
    <color name="brand_container">#E5F0FF</color>
    <color name="on_brand">#FFFFFF</color>

    <color name="status_error">#E13E37</color>
</resources>
