{
  "name": "@midscene/report",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "dev:rsdoctor": "RSDOCTOR=true rsbuild dev",
    "build:rsdoctor": "RSDOCTOR=true rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "generate-demo": "node scripts/generate-demo-report.mjs",
    "e2e": "pnpm run e2e:prepare && node ../../packages/test/bin/midscene-test --config ./midscene.config.ts",
    "e2e:prepare": "pnpm --dir ../.. exec nx run-many --target=build --projects=\"@midscene/report,@midscene/cli\" --verbose && node ../../scripts/validate-core-report-template.mjs && node scripts/generate-demo-report.mjs"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "build",
          "^build",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/scripts/report-template-utils.mjs",
          "{workspaceRoot}/scripts/report-template-utils.d.mts"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{workspaceRoot}/packages/core/dist/lib/report-html-template.js",
          "{workspaceRoot}/packages/core/dist/es/report-html-template.mjs"
        ]
      }
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.1",
    "@midscene/core": "workspace:*",
    "@midscene/playground": "workspace:*",
    "@midscene/shared": "workspace:*",
    "@midscene/visualizer": "workspace:*",
    "@midscene/web": "workspace:*",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-less": "^1.6.4",
    "@rsbuild/plugin-react": "^1.4.6",
    "@types/chrome": "0.0.279",
    "antd": "^5.21.6",
    "fflate": "0.8.3",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-json-view-lite": "2.5.0",
    "react-resizable-panels": "2.0.22",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@midscene/test": "workspace:*",
    "@rsbuild/plugin-node-polyfill": "1.4.6",
    "@rsbuild/plugin-svgr": "^1.3.1",
    "@rsdoctor/rspack-plugin": "1.6.5",
    "@rstest/core": "0.12.0",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^16.4.5",
    "less": "^4.2.0",
    "puppeteer": "24.43.1",
    "rsbuild-plugin-workspace-dev": "1.0.0",
    "sirv": "2.0.4",
    "typescript": "^5.8.3"
  }
}
