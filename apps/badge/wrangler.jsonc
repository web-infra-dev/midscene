{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midscene-badge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "badge.midscenejs.com", "custom_domain": true }]
}
