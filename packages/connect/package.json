{
  "name": "@midscene/connect",
  "version": "1.18.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/midscene.git",
    "directory": "packages/connect"
  },
  "description": "Connect any screen to Midscene: define a device in one file, serve it over HTTP, drive it with Agent, CLI and Playground",
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "midscene-connect": "./bin/midscene-connect"
  },
  "files": ["bin", "dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/es/server.mjs",
      "require": "./dist/lib/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run build:watch",
    "build": "rslib build",
    "build:watch": "rslib build --watch --no-clean",
    "test": "rstest"
  },
  "dependencies": {
    "@midscene/core": "workspace:*",
    "@midscene/playground": "workspace:*",
    "@midscene/shared": "workspace:*",
    "swagger-ui-dist": "^5.32.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@rslib/core": "~0.19.6",
    "@rstest/core": "0.12.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
