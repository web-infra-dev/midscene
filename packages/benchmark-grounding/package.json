{
  "name": "@midscene/benchmark-grounding",
  "version": "1.17.8",
  "description": "Grounding benchmark dataset, runner, viewer and standalone reports for Midscene.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./presets": {
      "types": "./dist/types/presets/index.d.ts",
      "import": "./dist/presets/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "midscene-benchmark-grounding": "./dist/cli/index.mjs"
  },
  "files": ["dist", "testcases"],
  "scripts": {
    "build": "rsbuild build && rslib build",
    "test": "rstest",
    "type-check": "tsc --project tsconfig.build.json --noEmit"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": ["build"]
      }
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^2.1.7",
    "@midscene/core": "workspace:*",
    "@midscene/shared": "workspace:*",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "es-toolkit": "^1.53.2",
    "hono": "^4.13.18",
    "open": "10.1.0",
    "p-queue": "^9.3.5",
    "p-retry": "^7.1.1",
    "terminal-link": "^5.0.0",
    "tinyrainbow": "^3.2.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rslib/core": "~0.19.6",
    "@rstest/core": "0.12.0",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
