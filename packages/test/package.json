{
  "name": "@midscene/test",
  "description": "Midscene Test: an extensible YAML testing framework and Node SDK.",
  "version": "1.13.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/midscene.git",
    "directory": "packages/test"
  },
  "homepage": "https://midscenejs.com/",
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "midscene-test": "./bin/midscene-test"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    },
    "./config": {
      "types": "./dist/types/cli/index.d.ts",
      "import": "./dist/es/cli/index.mjs",
      "require": "./dist/lib/cli/index.js"
    },
    "./midscene": {
      "types": "./dist/types/midscene/index.d.ts",
      "import": "./dist/es/midscene/index.mjs",
      "require": "./dist/lib/midscene/index.js"
    },
    "./internal/yaml-runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "import": "./dist/es/runtime/index.mjs",
      "require": "./dist/lib/runtime/index.js"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch --no-clean",
    "test": "vitest --run",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "e2e": "pnpm run build && vitest --run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "@midscene/core": "workspace:*",
    "@midscene/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "execa": "9.3.0",
    "glob": "11.0.0",
    "http-server": "14.1.1",
    "js-yaml": "4.1.0",
    "lodash.merge": "4.6.2",
    "tinyglobby": "0.2.15",
    "tsx": "^4.19.2",
    "yargs": "17.7.2",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@midscene/android": "workspace:*",
    "@midscene/computer": "workspace:*",
    "@midscene/harmony": "workspace:*",
    "@midscene/ios": "workspace:*",
    "@midscene/web": "workspace:*",
    "@rslib/core": "^0.18.3",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "^18.0.0",
    "@types/yargs": "17.0.32",
    "playwright": "^1.45.0",
    "puppeteer": "24.6.0",
    "typescript": "^5.8.3",
    "vitest": "3.0.5"
  },
  "peerDependencies": {
    "@midscene/android": "workspace:*",
    "@midscene/computer": "workspace:*",
    "@midscene/harmony": "workspace:*",
    "@midscene/ios": "workspace:*",
    "@midscene/web": "workspace:*",
    "playwright": "^1.45.0",
    "puppeteer": "24.6.0"
  },
  "peerDependenciesMeta": {
    "@midscene/android": {
      "optional": true
    },
    "@midscene/harmony": {
      "optional": true
    },
    "@midscene/ios": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "@midscene/computer": {
      "optional": true
    },
    "@midscene/web": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
