{
  "name": "@midscene/cli",
  "description": "An AI-powered automation SDK can control the page, perform assertions, and extract data in JSON format using natural language. See https://www.midscenejs.com/ for details.",
  "version": "1.18.2",
  "repository": "https://github.com/web-infra-dev/midscene",
  "homepage": "https://www.midscenejs.com/",
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    },
    "./framework": {
      "types": "./dist/types/framework/index.d.ts",
      "import": "./dist/es/framework/index.mjs",
      "require": "./dist/lib/framework/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "midscene": "./bin/midscene"
  },
  "files": ["dist", "README.md", "bin"],
  "scripts": {
    "dev": "npm run build:watch",
    "build": "rsbuild build && rslib build",
    "build:watch": "rsbuild build && rslib build --watch --no-clean",
    "test": "rstest",
    "test:e2e:shared-browser": "CLI_E2E=true rstest",
    "test:ai": "AITEST=true rstest",
    "test:ai:temp": "AITEST=true BRIDGE_MODE=true rstest tests/ai/bridge.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@hono/node-server": "^2.1.7",
    "@midscene/android": "workspace:*",
    "@midscene/computer": "workspace:*",
    "@midscene/core": "workspace:*",
    "@midscene/harmony": "workspace:*",
    "@midscene/ios": "workspace:*",
    "@midscene/shared": "workspace:*",
    "@midscene/test": "workspace:*",
    "@midscene/web": "workspace:*",
    "@rstest/core": "0.12.0",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "env-paths": "^4.0.0",
    "es-toolkit": "^1.53.2",
    "hono": "^4.13.18",
    "http-server": "14.1.1",
    "lodash.merge": "4.6.2",
    "open": "10.1.0",
    "p-queue": "^9.3.5",
    "p-retry": "^7.1.1",
    "pacote": "^21.5.3",
    "puppeteer": "24.43.1",
    "terminal-link": "^5.0.0",
    "tinyrainbow": "^3.2.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rslib/core": "~0.19.6",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.merge": "4.6.9",
    "@types/minimist": "1.2.5",
    "@types/node": "^18.0.0",
    "@types/pacote": "^11.1.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/yargs": "17.0.32",
    "chalk": "4.1.2",
    "cli-spinners": "3.2.0",
    "execa": "9.3.0",
    "glob": "14.0.4",
    "jose": "5.9.6",
    "js-yaml": "4.3.2",
    "p-limit": "6.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "restore-cursor": "5.1.0",
    "typescript": "^5.8.3",
    "yargs": "17.7.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
