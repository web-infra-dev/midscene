{
  "name": "@midscene/computer-playground",
  "version": "1.17.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/midscene.git",
    "directory": "packages/computer-playground"
  },
  "description": "Computer playground for Midscene - PC desktop automation",
  "main": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "module": "./dist/es/index.mjs",
  "files": ["dist", "static", "bin", "README.md"],
  "bin": {
    "midscene-computer-playground": "./bin/computer-playground",
    "@midscene/computer-playground": "./bin/computer-playground"
  },
  "scripts": {
    "dev": "npm run build:watch",
    "dev:server": "npm run build && ./bin/computer-playground",
    "test": "rstest",
    "build": "rslib build",
    "build:watch": "rslib build --watch --no-clean"
  },
  "dependencies": {
    "@midscene/computer": "workspace:*",
    "@midscene/core": "workspace:*",
    "@midscene/playground": "workspace:*",
    "@midscene/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "puppeteer": "24.43.1"
  },
  "devDependencies": {
    "@rslib/core": "~0.19.6",
    "@rstest/core": "0.12.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^18.0.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
