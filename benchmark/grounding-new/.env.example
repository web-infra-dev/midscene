# Copy to .env and replace the example URLs, API keys, families, and model names.
# 复制为 .env，并替换示例中的地址、API Key、模型家族和模型名称。
# displayName is optional; it controls result folders and viewer labels, defaulting to name.
# displayName 可选，用于结果目录和界面展示，省略时使用 name；name 始终用于 API 调用。
# displayName (or name) must yield a unique output directory after filename sanitization.
# displayName（或 name）转换后的输出目录名必须唯一。
# protocol is optional; defaults to openai-chat.
# protocol 可选，默认使用 openai-chat。
# reasoningEnabled is optional; omit it to use the adapter's default, or set true when the deployment requires thinking.
# reasoningEnabled 可选；省略时沿用适配器默认值，要求启用思考的部署需设为 true。
# Jev uses family "jev" and a System One Base URL; omit protocol.
# Jev 使用 family "jev" 和 System One Base URL；省略 protocol。
# displayFamily selects a report family from families; family selects the Midscene adapter.
# displayFamily 对应 families 中的报告家族；family 用于选择 Midscene 适配器。
# families defines family names, colors and optional logo URLs. Other is the fallback family.
# families 配置家族名称、颜色和可选的 Logo URL；Other 为未配置模型的默认家族。
# reference optionally defines sourced pricing and performance. The values below are illustrative only.
# reference 可选，用于记录有来源的价格与性能；以下数值仅为示例。
# Only public model and family fields are sent to the viewer; API keys and connection settings stay on the server.
# Viewer 仅接收模型与家族的公开字段，API Key 和连接配置仅在服务端读取。
MIDSCENE_GROUNDING_EVALUATION_CONFIG=`{
  "models": [
    {
      "baseUrl": "https://api.example.com/v1",
      "apiKey": "your-api-key-a",
      "family": "gpt-6",
      "name": "model-a",
      "displayName": "model-a-baseline",
      "protocol": "openai-responses",
      "displayFamily": "GPT",
      "reference": {
        "source": "Example only; replace with a verified source",
        "url": "https://example.com/models/model-a",
        "observedAt": "2026-11-11T00:00:00Z",
        "pricing": {
          "basis": "example",
          "currency": "USD",
          "inputPerToken": 2e-06,
          "outputPerToken": 1e-05
        },
        "performance": {
          "basis": "best-per-metric",
          "percentile": "p50",
          "timeToFirstTokenMs": 1000,
          "outputTokensPerSecond": 100
        }
      }
    },
    {
      "baseUrl": "https://api.example.com/v1",
      "apiKey": "your-api-key-b",
      "family": "qwen3-vl",
      "name": "model-b",
      "displayFamily": "Qwen"
    }
  ],
  "families": {
    "GPT": {
      "color": "#d65379",
      "logo": "https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1.95.1/icons/openai.svg"
    },
    "Qwen": {
      "color": "#9363d8",
      "logo": "https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1.95.1/icons/qwen-color.svg"
    },
    "Other": {
      "color": "#487f9e"
    }
  }
}`
