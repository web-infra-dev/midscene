# Copy to .env and replace the example URLs, API keys, families, and model names.
# 复制为 .env，并替换示例中的地址、API Key、模型家族和模型名称。
# Model names must yield unique output directory names.
# 模型名称转换后的输出目录名必须唯一。
# MIDSCENE_MODEL_PROTOCOL is optional; defaults to openai-chat.
# MIDSCENE_MODEL_PROTOCOL 可选，默认使用 openai-chat。
MIDSCENE_MODELS='[
  {
    "MIDSCENE_MODEL_BASE_URL": "https://api.example.com/v1",
    "MIDSCENE_MODEL_API_KEY": "your-api-key-a",
    "MIDSCENE_MODEL_FAMILY": "gpt-6",
    "MIDSCENE_MODEL_NAME": "model-a",
    "MIDSCENE_MODEL_PROTOCOL": "openai-responses"
  },
  {
    "MIDSCENE_MODEL_BASE_URL": "https://api.example.com/v1",
    "MIDSCENE_MODEL_API_KEY": "your-api-key-b",
    "MIDSCENE_MODEL_FAMILY": "qwen3-vl",
    "MIDSCENE_MODEL_NAME": "model-b"
  }
]'
