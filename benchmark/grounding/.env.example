# Copy to .env; credentials and output are ignored by Git.
MIDSCENE_MODEL_NAME=qwen3.7-plus
MIDSCENE_MODEL_FAMILY=qwen3
MIDSCENE_MODEL_BASE_URL=https://your-provider.example/v1
MIDSCENE_MODEL_API_KEY=replace-with-your-key
# Set only for a provider/model that supports Responses:
# MIDSCENE_MODEL_PROTOCOL=openai-responses
# Legacy MIDSCENE_MODEL_API_TYPE=responses is also accepted by this benchmark.
