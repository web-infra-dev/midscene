{
  "name": "@midscene/benchmark-grounding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "evaluate": "tsx scripts/cli.ts",
    "run:midscene-evaluation": "tsx scripts/cli.ts",
    "build": "rsbuild build --config dashboard/rsbuild.report.config.ts",
    "build:report-template": "rsbuild build --config dashboard/rsbuild.report.config.ts",
    "validate:data": "tsx scripts/validate-dataset.ts",
    "test": "tsx --test tests/*.test.ts evaluation/report-page/*.test.ts",
    "typecheck": "tsc --noEmit",
    "report": "tsx scripts/generate-report.ts"
  },
  "dependencies": {
    "@midscene/core": "workspace:*",
    "@midscene/shared": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.1.10",
    "dotenv": "^16.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-react": "^1.4.1",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
